<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FiveMMcp</RootNamespace>
    <AssemblyName>FiveMMcp</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibraryImport source generator emits unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The companion FiveM resource ships alongside but builds separately. -->
    <Compile Remove="resources/**" />
    <None Remove="resources/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

</Project>
